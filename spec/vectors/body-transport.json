[
  {
    "description": "Requirements body encode/decode",
    "input": {
      "type": "requirements",
      "value": {
        "x402Version": 2,
        "resource": {
          "url": "https://api.example.com/paid"
        },
        "accepts": [
          {
            "scheme": "exact",
            "network": "sui:mainnet",
            "asset": "0x2::sui::SUI",
            "amount": "1000000",
            "payTo": "0xabcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890"
          }
        ]
      }
    },
    "expected": {
      "body": "{\"x402Version\":2,\"resource\":{\"url\":\"https://api.example.com/paid\"},\"accepts\":[{\"scheme\":\"exact\",\"network\":\"sui:mainnet\",\"asset\":\"0x2::sui::SUI\",\"amount\":\"1000000\",\"payTo\":\"0xabcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890\",\"maxTimeoutSeconds\":60,\"extra\":{}}],\"extensions\":{\"s402\":{\"version\":\"2\"}}}",
      "decoded": {
        "x402Version": 2,
        "resource": {
          "url": "https://api.example.com/paid"
        },
        "accepts": [
          {
            "scheme": "exact",
            "network": "sui:mainnet",
            "asset": "0x2::sui::SUI",
            "amount": "1000000",
            "payTo": "0xabcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890",
            "maxTimeoutSeconds": 60
          }
        ]
      }
    },
    "shouldReject": false
  },
  {
    "description": "Requirements body with extensions",
    "input": {
      "type": "requirements",
      "value": {
        "x402Version": 2,
        "resource": {
          "url": "https://api.example.com/paid",
          "description": "Paid content",
          "mimeType": "application/json"
        },
        "accepts": [
          {
            "scheme": "exact",
            "network": "sui:mainnet",
            "asset": "0x2::sui::SUI",
            "amount": "1000000",
            "payTo": "0xabcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890",
            "extensions": {
              "auction": {
                "type": "sealed-bid",
                "deadline": 1708000000000
              },
              "customField": "hello world"
            }
          }
        ]
      }
    },
    "expected": {
      "body": "{\"x402Version\":2,\"resource\":{\"url\":\"https://api.example.com/paid\",\"description\":\"Paid content\",\"mimeType\":\"application/json\"},\"accepts\":[{\"scheme\":\"exact\",\"network\":\"sui:mainnet\",\"asset\":\"0x2::sui::SUI\",\"amount\":\"1000000\",\"payTo\":\"0xabcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890\",\"maxTimeoutSeconds\":60,\"extra\":{\"extensions\":{\"auction\":{\"type\":\"sealed-bid\",\"deadline\":1708000000000},\"customField\":\"hello world\"}}}],\"extensions\":{\"s402\":{\"version\":\"2\"}}}",
      "decoded": {
        "x402Version": 2,
        "resource": {
          "url": "https://api.example.com/paid",
          "description": "Paid content",
          "mimeType": "application/json"
        },
        "accepts": [
          {
            "scheme": "exact",
            "network": "sui:mainnet",
            "asset": "0x2::sui::SUI",
            "amount": "1000000",
            "payTo": "0xabcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890",
            "maxTimeoutSeconds": 60,
            "extensions": {
              "auction": {
                "type": "sealed-bid",
                "deadline": 1708000000000
              },
              "customField": "hello world"
            }
          }
        ]
      }
    },
    "shouldReject": false
  },
  {
    "description": "Upto requirements body with estimatedAmount",
    "input": {
      "type": "requirements",
      "value": {
        "x402Version": 2,
        "resource": {
          "url": "https://api.example.com/paid",
          "description": "Paid content",
          "mimeType": "application/json"
        },
        "accepts": [
          {
            "scheme": "upto",
            "network": "sui:mainnet",
            "asset": "0x2::sui::SUI",
            "amount": "1000000",
            "payTo": "0xabcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890",
            "upto": {
              "maxAmount": "10000000",
              "settlementDeadlineMs": "1700000000000",
              "usageReportUrl": "https://api.example.com/usage",
              "estimatedAmount": "7500000"
            }
          }
        ]
      }
    },
    "expected": {
      "body": "{\"x402Version\":2,\"resource\":{\"url\":\"https://api.example.com/paid\",\"description\":\"Paid content\",\"mimeType\":\"application/json\"},\"accepts\":[{\"scheme\":\"upto\",\"network\":\"sui:mainnet\",\"asset\":\"0x2::sui::SUI\",\"amount\":\"1000000\",\"payTo\":\"0xabcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890\",\"maxTimeoutSeconds\":60,\"extra\":{\"upto\":{\"maxAmount\":\"10000000\",\"settlementDeadlineMs\":\"1700000000000\",\"usageReportUrl\":\"https://api.example.com/usage\",\"estimatedAmount\":\"7500000\"}}}],\"extensions\":{\"s402\":{\"version\":\"2\"}}}",
      "decoded": {
        "x402Version": 2,
        "resource": {
          "url": "https://api.example.com/paid",
          "description": "Paid content",
          "mimeType": "application/json"
        },
        "accepts": [
          {
            "scheme": "upto",
            "network": "sui:mainnet",
            "asset": "0x2::sui::SUI",
            "amount": "1000000",
            "payTo": "0xabcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890",
            "maxTimeoutSeconds": 60,
            "upto": {
              "maxAmount": "10000000",
              "settlementDeadlineMs": "1700000000000",
              "usageReportUrl": "https://api.example.com/usage",
              "estimatedAmount": "7500000"
            }
          }
        ]
      }
    },
    "shouldReject": false
  },
  {
    "description": "Payload body encode/decode",
    "input": {
      "type": "payload",
      "value": {
        "s402Version": "1",
        "scheme": "exact",
        "payload": {
          "transaction": "dHhfYnl0ZXM=",
          "signature": "c2lnX2J5dGVz"
        }
      }
    },
    "expected": {
      "body": "{\"s402Version\":\"1\",\"scheme\":\"exact\",\"payload\":{\"transaction\":\"dHhfYnl0ZXM=\",\"signature\":\"c2lnX2J5dGVz\"}}",
      "decoded": {
        "s402Version": "1",
        "scheme": "exact",
        "payload": {
          "transaction": "dHhfYnl0ZXM=",
          "signature": "c2lnX2J5dGVz"
        }
      }
    },
    "shouldReject": false
  },
  {
    "description": "Settle body encode/decode",
    "input": {
      "type": "settle",
      "value": {
        "success": true,
        "txDigest": "ABC123",
        "finalityMs": 300
      }
    },
    "expected": {
      "body": "{\"success\":true,\"txDigest\":\"ABC123\",\"finalityMs\":300}",
      "decoded": {
        "success": true,
        "txDigest": "ABC123",
        "finalityMs": 300
      }
    },
    "shouldReject": false
  },
  {
    "description": "Settle failure body encode/decode",
    "input": {
      "type": "settle",
      "value": {
        "success": false,
        "error": "Gas object not found",
        "errorCode": "SETTLEMENT_FAILED"
      }
    },
    "expected": {
      "body": "{\"success\":false,\"error\":\"Gas object not found\",\"errorCode\":\"SETTLEMENT_FAILED\"}",
      "decoded": {
        "success": false,
        "error": "Gas object not found",
        "errorCode": "SETTLEMENT_FAILED"
      }
    },
    "shouldReject": false
  }
]
