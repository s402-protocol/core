[
  {
    "description": "Requirements header roundtrip: encode → decode → re-encode = identical",
    "input": {
      "type": "requirements",
      "transport": "header",
      "value": {
        "x402Version": 2,
        "resource": {
          "url": "https://api.example.com/paid"
        },
        "accepts": [
          {
            "scheme": "exact",
            "network": "sui:mainnet",
            "asset": "0x2::sui::SUI",
            "amount": "1000000",
            "payTo": "0xabcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890"
          }
        ]
      }
    },
    "expected": {
      "firstEncode": "",
      "reEncode": "",
      "identical": true
    },
    "shouldReject": false
  },
  {
    "description": "Requirements body roundtrip: encode → decode → re-encode = identical",
    "input": {
      "type": "requirements",
      "transport": "body",
      "value": {
        "x402Version": 2,
        "resource": {
          "url": "https://api.example.com/paid"
        },
        "accepts": [
          {
            "scheme": "exact",
            "network": "sui:mainnet",
            "asset": "0x2::sui::SUI",
            "amount": "1000000",
            "payTo": "0xabcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890"
          }
        ]
      }
    },
    "expected": {
      "firstEncode": "{\"x402Version\":2,\"resource\":{\"url\":\"https://api.example.com/paid\"},\"accepts\":[{\"scheme\":\"exact\",\"network\":\"sui:mainnet\",\"asset\":\"0x2::sui::SUI\",\"amount\":\"1000000\",\"payTo\":\"0xabcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890\",\"maxTimeoutSeconds\":60,\"extra\":{}}],\"extensions\":{\"s402\":{\"version\":\"2\"}}}",
      "reEncode": "{\"x402Version\":2,\"resource\":{\"url\":\"https://api.example.com/paid\"},\"accepts\":[{\"scheme\":\"exact\",\"network\":\"sui:mainnet\",\"asset\":\"0x2::sui::SUI\",\"amount\":\"1000000\",\"payTo\":\"0xabcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890\",\"maxTimeoutSeconds\":60,\"extra\":{}}],\"extensions\":{\"s402\":{\"version\":\"2\"}}}",
      "identical": true
    },
    "shouldReject": false
  },
