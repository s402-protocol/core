          "amount": "2000000",
          "payTo": "0xrecipient456"
        }
      ]
    },
    "expected": {
      "x402Version": 2,
      "resource": {
        "url": "https://api.example.com/paid"
      },
      "accepts": [
        {
          "scheme": "exact",
          "network": "sui:mainnet",
          "asset": "0x2::sui::SUI",
          "amount": "2000000",
          "payTo": "0xrecipient456",
          "expiresAt": 1700000060000
        }
      ]
    },
    "shouldReject": false
  },
  {
    "description": "x402 V2 envelope (multiple offers) → s402 (first offer taken)",
