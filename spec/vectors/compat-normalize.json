          "asset": "0x2::sui::SUI",
          "amount": "1000000",
          "payTo": "0xrecipientFirst"
        },
        {
          "scheme": "exact",
          "network": "eip155:8453",
          "asset": "USDC",
          "amount": "500000",
          "payTo": "0xrecipientSecond"
        }
      ]
    },
    "expected": {
      "x402Version": 2,
      "resource": {
        "url": "https://api.example.com/paid"
      },
      "accepts": [
        {
          "scheme": "exact",
          "network": "sui:mainnet",
          "asset": "0x2::sui::SUI",
          "amount": "1000000",
          "payTo": "0xrecipientFirst",
          "expiresAt": 1700000060000
        },
        {
          "scheme": "exact",
          "network": "eip155:8453",
          "asset": "USDC",
          "amount": "500000",
          "payTo": "0xrecipientSecond",
          "expiresAt": 1700000060000
        }
      ]
    },
    "shouldReject": false
  },
