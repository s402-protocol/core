[
  {
    "description": "x402 V1 flat format → s402",
    "input": {
      "x402Version": 1,
      "scheme": "exact",
      "network": "sui:mainnet",
      "asset": "0x2::sui::SUI",
      "amount": "1000000",
      "payTo": "0xrecipient123",
      "maxTimeoutSeconds": 60
    },
    "expected": {
      "x402Version": 2,
      "resource": {
        "url": ""
      },
      "accepts": [
        {
          "scheme": "exact",
          "network": "sui:mainnet",
          "asset": "0x2::sui::SUI",
          "amount": "1000000",
          "payTo": "0xrecipient123",
          "maxTimeoutSeconds": 60,
          "expiresAt": 1700000060000
        }
      ]
    },
    "shouldReject": false
  },
  {
